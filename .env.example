# Copy this file to .env and paste your keys. Never share .env.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Stock footage: fill ONE of these. Pexels is used if both are set.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Discord control (bot.py) - different on each computer ----
DISCORD_BOT_TOKEN=
DISCORD_SERVER_ID=
DISCORD_CONTROL_CHANNEL_ID=
MACHINE_NAME=PC-1
# Which channels from config.yaml THIS computer makes (comma separated)
MACHINE_CHANNELS=mindset_minute
# yes = this computer also runs story mode (Candlelit Tales: Stories button, /story-* commands,
# review cards for the story channels). Only one computer should say yes.
MACHINE_STORIES=no
# yes = this computer also runs the Thai news recaps (สรุปให้ฟัง: /news command, fact review cards).
# Only one computer should say yes.
MACHINE_NEWS=no
# yes = this computer shows the "Popular ideas" button (channels with trend_queries, e.g. Wonder Minute)
MACHINE_IDEAS=no

# Facebook Reels / Instagram Reels posting after Approve (optional, README section 11).
# One set per channel key (upper case); switch it on in config.yaml crosspost.channels.
META_PAGE_ID_SUMMED_UP=
META_PAGE_TOKEN_SUMMED_UP=
META_IG_ID_SUMMED_UP=
